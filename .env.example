# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Judge model (Layer 2) ──────────────────────────────────────────────────────
# Model used for LLM-as-judge evaluation
JUDGE_MODEL=claude-sonnet-4-6
# Fallback cheaper model for bulk judgment runs
JUDGE_MODEL_FAST=claude-haiku-4-5-20251001

# ── Thresholds ─────────────────────────────────────────────────────────────────
# Minimum passing score (0-1) for each rubric dimension
FAITHFULNESS_THRESHOLD=0.7
RELEVANCE_THRESHOLD=0.7
COMPLETENESS_THRESHOLD=0.6
CORRECTNESS_THRESHOLD=0.7

# ── Layer 3: Feedback Loops ────────────────────────────────────────────────────
# Min confidence required before auto-promoting a production example to golden set
AUTO_PROMOTE_THRESHOLD=0.85
# Path to the feedback log (relative to repo root)
FEEDBACK_LOG_PATH=evals/layer3_feedback/storage/feedback_log.jsonl
