# .env.example – copy to .env and fill in real values.
# .env is gitignored — never commit real keys.
# Environment variables always take precedence over eval_config.yaml.

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Required for the real LLM judge (ClaudeJudge). Leave blank to use MockClaudeJudge.
ANTHROPIC_API_KEY=

# ── Judge selection ────────────────────────────────────────────────────────────
# Set to "true" to force MockClaudeJudge regardless of ANTHROPIC_API_KEY.
# Useful in CI pipelines: deterministic, zero-cost, no network calls.
#
#   USE_MOCK_JUDGE=true   -> always MockClaudeJudge
#   USE_MOCK_JUDGE=false  -> auto-detect (real if ANTHROPIC_API_KEY is set)
USE_MOCK_JUDGE=false

# Model used by the real judge (ClaudeJudge). Options:
#   claude-sonnet-4-6          (default – best balance of quality and speed)
#   claude-opus-4-7            (highest quality, slower)
#   claude-haiku-4-5-20251001  (fastest, lowest cost)
JUDGE_MODEL=claude-sonnet-4-6

# ── Score thresholds ───────────────────────────────────────────────────────────
# Weighted-average LLM judge score required to pass Layer 2b (0.0 – 1.0).
JUDGE_THRESHOLD=0.70

# Traces with a judge score below this value are auto-flagged as failure candidates.
AUTO_PROMOTE_THRESHOLD=0.85

# ── Agent wiring (set in eval_config.yaml, not here) ──────────────────────────
# To plug in a real agent, add this block to eval_config.yaml:
#
#   agent:
#     module:   my_package.handler    # importable Python dotted path
#     function: generate_answer       # callable(question: str, context: str) -> str
#
# Then run:  python run_evals.py run
# The CLI imports the module at startup and passes (question, context) to the
# function for each golden entry.

# ── Retrieval mode (set in eval_config.yaml, not here) ────────────────────────
# To switch retrieval mode, update eval_config.yaml:
#
#   retrieval:
#     mode: structured           # keyword (default) | structured
#     faq_path: docs/faq.md      # Markdown fallback always loaded
#     structured_path: docs/faq.json  # JSON/YAML Q-A pairs (structured mode)
#     top_k: 2
